{
    "suite": "TableOperatorFuzz",
    "case": "WatermarkAssignerFuzz",
    "description": "Fuzz tests for WatermarkAssignerOperator (P0) covering event time processing and watermark generation",
    "fuzz_function": "WatermarkAssignerFuzz",
    "parameters": [
        {"name": "fzd", "type": "WatermarkAssignerFuzzData"},
        {"name": "loopCount", "type": "uint16_t"},
        {"name": "chooseMode", "type": "uint16_t"}
    ],
    "test_points": [
        {"id": "watermark_basic", "description": "Basic processBatch with monotonic timestamps", "coverage": ["processBatch", "finish", "monotonic"]},
        {"id": "watermark_out_of_order", "description": "Out-of-order events with tolerance", "coverage": ["outOfOrder", "tolerance", "watermarkAdvance"]},
        {"id": "watermark_multiple_batches", "description": "Multiple batches with advancing watermark", "coverage": ["multipleBatches", "watermarkProgression"]}
    ],
    "data_distributions": ["monotonic", "out_of_order", "bursty"],
    "boundary_conditions": ["zero_tolerance", "max_lateness", "single_event"]
}
